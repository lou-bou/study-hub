# Install with studysite-ingest.service:
#   sudo cp deploy/studysite-ingest.{path,service} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now studysite-ingest.path
[Unit]
Description=Study Hub: watch the upload inbox

[Path]
DirectoryNotEmpty=/srv/studysite/data/inbox
Unit=studysite-ingest.service

[Install]
WantedBy=multi-user.target
